{
    "ssh_connections": [
        {
            "host": "orb",
            "args": [],
            "projects": [
                {
                    "paths": ["/home/daniel/starforge/dotfiles"]
                }
            ],
            "nickname": "mustafar"
        }
    ],
    "diagnostics": {
        "inline": {
            "enabled": true
        }
    },
    "git": {
        "inline_blame": {
            "show_commit_summary": true
        }
    },
    "colorize_brackets": true,
    "ui_font_family": "Ioskeley Mono",
    "buffer_font_family": "Ioskeley Mono",
    "terminal": {
        "font_family": "Ioskeley Mono"
    },
    "agent_servers": {
        "claude-acp": {
            "type": "registry"
        }
    },
    "cli_default_open_behavior": "new_window",
    "code_lens": "on",
    "languages": {
        "Go": {
            "colorize_brackets": true,
            "indent_guides": {
                "background_coloring": "indent_aware"
            }
        }
    },
    "restore_on_startup": "launchpad",
    "redact_private_values": false,
    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": []
    },
    "git_panel": {
        "tree_view": true,
        "file_icons": false,
        "dock": "left"
    },
    "outline_panel": {
        "dock": "left"
    },
    "project_panel": {
        "git_status_indicator": true,
        "dock": "left"
    },
    "collaboration_panel": {
        "button": false
    },
    "inlay_hints": {
        "enabled": true
    },
    "session": {
        "trust_all_worktrees": true
    },
    "autosave": {
        "after_delay": {
            "milliseconds": 1000
        }
    },
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "format_on_save": "on",
    "soft_wrap": "editor_width",

    "icon_theme": {
        "mode": "dark",
        "light": "Material Icon Theme",
        "dark": "Material Icon Theme"
    },
    "ui_font_size": 16,
    "buffer_font_size": 15,
    "theme": {
        "mode": "dark",
        "light": "ultraViolet Blur",
        "dark": "ultraViolet Blur"
    },

    "telemetry": {
        "diagnostics": false,
        "metrics": false
    }
}
