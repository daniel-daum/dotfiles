// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    // ======================
    // LLM AGENT
    // ======================
    "edit_predictions": {
        "mode": "eager",
        "allow_data_collection": "no"
    },
    "cli_default_open_behavior": "new_window",
    "diff_view_style": "split",
    "language_models": {
        "openai_compatible": {
            "lmstudio-local": {
                "api_url": "http://127.0.0.1:1234/v1",
                "available_models": [
                    {
                        "name": "qwen3.6-35b-a3b-splash",
                        "display_name": "Qwen3.6 35B A3B",
                        "max_tokens": 262144,
                        "capabilities": {
                            "tools": true,
                            "images": true,
                            "parallel_tool_calls": false,
                            "prompt_cache_key": false
                        }
                    },
                    {
                        "name": "swift-1.5-qwen3.8-27b-splash",
                        "display_name": "Swift 1.5 Qwen3.8 27B",
                        "max_tokens": 262144,
                        "capabilities": {
                            "tools": true,
                            "images": true,
                            "parallel_tool_calls": false,
                            "prompt_cache_key": false
                        }
                    }
                ]
            }
        }
    },
    "agent": {
        "threads_sidebar": {
            "position": "right"
        },
        "thinking_display": "preview",
        "single_file_review": true,
        "terminal_init_command": "",
        "show_turn_stats": true,
        "default_model": {
            "provider": "lmstudio-local",
            "model": "qwen3.6-35b-a3b-splash",
            "enable_thinking": false
        },
        "default_profile": "ask",
        "notify_when_agent_waiting": "all_screens",
        "play_sound_when_agent_done": "always",
        "dock": "right"
    },
    // ======================
    // PERSONAL ZED SETTINGS
    // ======================
    "restore_on_startup": "launchpad",
    "redact_private_values": true,

    "autosave": {
        "after_delay": {
            "milliseconds": 1000
        }
    },
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "format_on_save": "on",
    "soft_wrap": "editor_width",
    "colorize_brackets": true,

    "git_hosting_providers": [
        {
            "provider": "gitea",
            "name": "My Gitea",
            "base_url": "https://git.danieldaum.net"
        }
    ],
    // ======================
    // SSH
    // ======================

    "ssh_connections": [
        {
            "host": "orb",
            "args": ["-A"],
            "projects": [
                {
                    "paths": ["/home/daniel/starforge/dotfiles"]
                },
                {
                    "paths": ["/home/daniel/starforge/holonet"]
                }
            ],
            "nickname": "Mustafar"
        },
        {
            "host": "ziost",
            "args": ["-A"],
            "projects": [
                {
                    "paths": ["/home/maliciouspickle/ziost"]
                }
            ]
        },
        {
            "host": "dxun",
            "args": [],
            "projects": [
                {
                    "paths": ["/home/maliciouspickle/services"]
                }
            ]
        }
    ],

    // ======================
    // THEME & VISUAL CONFIG
    // ======================
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "Warp One Dark"
    },
    "ui_font_family": "Ioskeley Mono",
    "buffer_font_family": "Ioskeley Mono",
    "terminal": {
        "font_family": "Ioskeley Mono"
    },
    "ui_font_size": 16,
    "buffer_font_size": 15,

    "icon_theme": {
        "mode": "system",
        "light": "Material Icon Theme",
        "dark": "Material Icon Theme"
    },

    "indent_guides": {
        "background_coloring": "indent_aware"
    },

    "git_panel": {
        "tree_view": true,
        "file_icons": false,
        "dock": "left"
    },

    "outline_panel": {
        "dock": "left"
    },
    "project_panel": {
        "git_status_indicator": true,
        "dock": "left"
    },
    "collaboration_panel": {
        "button": false
    },

    // ======================
    // TELEMETRY
    // ======================

    "telemetry": {
        "diagnostics": false,
        "metrics": false,
        "anthropic_retention": false
    },
    // ======================
    // DEVELOPMENTAL - FEATURE FLAGS
    // ======================
    "feature_flags": {
        "tabular-data-preview": "on",
        "notebooks": "on"
    }
}
