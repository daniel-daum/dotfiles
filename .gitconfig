[user]
	name = daniel daum
	email = daniel@danieldaum.net
	signingkey = /Users/daniel/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/PublicKeys/d3b848b40c1cb5e70d1d6e3e2c9aa4ea.pub
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.gitallowedsigners
[push]
	autoSetupRemote = true
[merge]
	conflictStyle = zdiff3
[alias]
	s  = status --short --branch
	a  = add
	ap = add --patch
	aa = add --all
	c  = commit --message
	ca = commit --all --message
	am = commit --amend --no-edit
	pl = pull --rebase
	ps = push
	fp = fetch --prune
	co = checkout
	sw = switch
	b  = branch
	l  = log --oneline --graph --decorate -20
	d  = diff
	ds = diff --staged
	undo = reset --soft HEAD~1
	sweep = "!git branch --merged | grep -v '\\*\\|main\\|master' | xargs -n 1 git branch -d"
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true

[merge]
    conflictStyle = zdiff3

[diff]
    tool = difftastic

[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"

[difftool]
    prompt = false

[pager]
    difftool = less -R
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
