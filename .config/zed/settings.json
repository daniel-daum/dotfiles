// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // ======================
  // PERSONAL ZED SETTINGS
  // ======================
  "ssh_connections": [
    {
      "host": "orb",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/daniel/starforge/saturn"
          ]
        }
      ]
    }
  ],
  "restore_on_startup": "launchpad",
  "redact_private_values": true,
  "autosave": "on_focus_change",
  // "autosave": {
  //   "after_delay": {
  //     "milliseconds": 1000,
  //   },
  // },
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "format_on_save": "on",
  "soft_wrap": "editor_width",
  "colorize_brackets": true,
  "git_hosting_providers": [
    {
      "provider": "gitea",
      "name": "My Gitea",
      "base_url": "https://git.danieldaum.net",
    },
  ],
  "title_bar": { "show_sign_in": false },
  "inlay_hints": { "enabled": true },
  "diagnostics": { "inline": { "enabled": true } },
  "sticky_scroll": { "enabled": true },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "errors",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "theme": {
    "mode": "system",
    "light": "Ink",
    "dark": "Moss",
  },
  "ui_font_family": "Ioskeley Mono",
  "buffer_font_family": "Ioskeley Mono",
  "terminal": {
    "font_family": "IoskeleyMonoTerm Nerd Font Mono",
    "line_height": "standard",
    "cursor_shape": "bar",
    "copy_on_select": true,
    "option_as_meta": true,
    "toolbar": { "breadcrumbs": true },
    "shell": "system",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "indent_guides": {
    "background_coloring": "indent_aware",
  },
  "git_panel": {
    "tree_view": true,
    "file_icons": false,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "project_panel": {
    "git_status_indicator": true,
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
  },
  // ======================
  // DEVELOPMENTAL - FEATURE FLAGS
  // ======================
  "feature_flags": {
    "tabular-data-preview": "on",
    "notebooks": "on",
  },

  // ======================
  // PERSONAL - SSH
  // ======================
  //
  //

  // ======================
  // LLM AGENT
  // ======================
  // LM Studio models show up automatically in the agent's model dropdown
  // (built-in "lmstudio" provider, default address localhost:1234).
  "agent": {
    "default_model": {
      "provider": "lmstudio",
      "model": "swift-1.5-qwen3.8-27b-splash",
      "enable_thinking": false,
    },
    "default_profile": "write",
    "dock": "right",
    "threads_sidebar": { "position": "right" },
    "tool_permissions": {
      "default": "allow",
      "tools": { "terminal": { "default": "allow" } },
    },
    "sandbox_permissions": {
      "allow_fs_write_all": true,
      "allow_all_hosts": true,
    },
    "thinking_display": "always_collapsed",
    "expand_terminal_card": false,
    "single_file_review": true,
    "show_turn_stats": true,
    "notify_when_agent_waiting": "all_screens",
    "play_sound_when_agent_done": "always",
  },
}
